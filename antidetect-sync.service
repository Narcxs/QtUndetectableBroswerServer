# Unite systemd pour le serveur de synchro antidetect (cloud v2).
# Installation : sudo cp antidetect-sync.service /etc/systemd/system/
#                sudo systemctl daemon-reload && sudo systemctl enable --now antidetect-sync
# Le token et la config sont dans /etc/antidetect-sync.env (hors de l'unite,
# chmod 600) : SYNC_TOKEN (obligatoire), SYNC_HOST, SYNC_PORT, SYNC_STORE.
[Unit]
Description=Antidetect Sync - serveur de synchro profils (zero-knowledge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=syncsrv
Group=syncsrv
WorkingDirectory=/opt/antidetect-sync
EnvironmentFile=/etc/antidetect-sync.env
ExecStart=/opt/antidetect-sync/venv/bin/python /opt/antidetect-sync/sync_server.py
Restart=on-failure
RestartSec=3

# Durcissement de base : tout est en lecture seule sauf le store.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/antidetect-sync

[Install]
WantedBy=multi-user.target
